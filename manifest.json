{
  "manifest_version": 3,
  "name": "Limpar Cache WhatsApp Web",
  "version": "1.1",
  "description": "Limpa apenas os dados do web.whatsapp.com",
  "permissions": [
    "browsingData"
  ],
  "host_permissions": [
    "https://web.whatsapp.com/*"
  ],
  "action": {
    "default_popup": "popup.html"
  }
}
